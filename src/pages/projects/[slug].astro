---
/**
 * Page: Dynamic Project Details ([slug].astro)
 * Description: Displays project information, interactive gallery slider, and Lightbox viewer.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Layout title={`${data.title} | HERITAGE APEX`}>

    <section class="relative w-full min-h-[calc(100vh-90px)] bg-[var(--darker-brown)] pt-12 pb-16 overflow-hidden">

        <div
            class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-5 mix-blend-luminosity pointer-events-none z-0"
            style="background-image: url('/images/background.jpg');"
            aria-hidden="true"
        ></div>

        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--darker-brown)] pointer-events-none z-0"></div>

        <main class="relative z-10 max-w-[1450px] w-full mx-auto px-[6%] md:px-[8%]">

            <section class="mb-8 md:mb-10">
                <div class="max-w-[900px]">
                    <span class="text-[11px] md:text-[12px] tracking-[3px] font-semibold text-[var(--accent-orange)] block mb-2">
                        {data.category}
                    </span>

                    <h1 class="text-[2.2rem] sm:text-[3rem] md:text-[3.5rem] font-extrabold leading-[1.1] mb-3 md:mb-4 text-white">
                        {data.title}
                    </h1>

                    <p class="text-[0.95rem] sm:text-[1.05rem] text-gray-300 leading-[1.6] line-clamp-2 md:line-clamp-none">
                        {data.description}
                    </p>
                </div>
            </section>

            <section>
                <div class="mb-4 md:mb-6">
                    <span class="text-[10px] md:text-[12px] tracking-[2px] font-semibold text-[var(--accent-orange)] uppercase block mb-0.5">
                        GALLERY SHOWCASE
                    </span>

                    <h2 class="text-[1.6rem] sm:text-[2rem] font-bold text-white">
                        Project Views
                    </h2>
                </div>

                <div
                    id="horizontalSliderWrapper"
                    class="drag-slider-wrapper relative rounded-[12px] py-2 w-full"
                >
                    <div
                        id="horizontalSlider"
                        class="drag-slider-track flex gap-[20px] md:gap-[30px] w-max cursor-grab"
                    >
                        {data.gallery.map((img: string, index: number) => (
                            <div
                                class="gallery-item drag-slider-item w-[85vw] sm:w-[450px] md:w-[500px] h-[220px] sm:h-[260px] md:h-[300px] rounded-[12px] overflow-hidden shadow-xl relative cursor-pointer shrink-0 group border border-white/10 select-none"
                                data-index={index}
                            >
                                <img
                                    src={img}
                                    alt={`Gallery image ${index + 1}`}
                                    draggable="false"
                                    class="w-full h-full object-cover brightness-95 contrast-95 transition-transform duration-700 group-hover:scale-105 pointer-events-none"
                                />

                                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
                                    <span class="bg-black/70 text-white px-4 py-1.5 rounded-full text-xs tracking-wider uppercase font-semibold backdrop-blur-sm">
                                        Click to Expand
                                    </span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- تم تعديل الحاوية هنا لتكون في المنتصف للموبايل وفي اليمين للديسكتوب -->
                <div class="flex justify-center md:justify-end items-center gap-[15px] md:gap-[20px] mt-6 select-none">

                    <button
                        id="sliderPrev"
                        type="button"
                        class="text-[11px] font-bold tracking-[2.5px] uppercase text-gray-400 hover:text-[var(--accent-orange)] transition-colors cursor-pointer bg-transparent border-none"
                    >
                        PREV.
                    </button>

                    <div class="w-[80px] md:w-[100px] h-[2px] bg-white/15 relative overflow-hidden rounded-full">
                        <div
                            id="sliderProgress"
                            class="h-full bg-[var(--accent-orange)] transition-all duration-300 ease-out"
                            style="width: 0%;"
                        ></div>
                    </div>

                    <button
                        id="sliderNext"
                        type="button"
                        class="text-[11px] font-bold tracking-[2.5px] uppercase text-white hover:text-[var(--accent-orange)] transition-colors cursor-pointer bg-transparent border-none"
                    >
                        NEXT
                    </button>

                </div>
            </section>
        </main>
    </section>

    <div
        id="lightboxModal"
        class="fixed inset-0 bg-black/95 z-[9999] hidden items-center justify-center p-4"
    >
        <button
            id="lightboxClose"
            type="button"
            class="absolute top-[20px] right-[25px] md:top-[30px] md:right-[40px] text-white text-[2.5rem] bg-none border-none cursor-pointer hover:text-[var(--accent-orange)] z-50"
        >
            &times;
        </button>

        <button
            id="lightboxPrev"
            type="button"
            class="absolute left-[15px] md:left-[30px] top-1/2 -translate-y-1/2 bg-white/10 text-white text-[1.5rem] md:text-[1.8rem] px-3.5 py-3 md:px-5 md:py-4 border-none cursor-pointer rounded hover:bg-[var(--accent-orange)] z-50"
        >
            &#10094;
        </button>

        <div class="text-center max-w-[90vw] max-h-[85vh] flex flex-col items-center">
            <img
                id="lightboxImg"
                src=""
                alt="Expanded View"
                class="max-w-full max-h-[70vh] object-contain rounded shadow-2xl"
            />

            <p
                id="lightboxCaption"
                class="text-gray-300 mt-3 text-sm md:text-base"
            ></p>
        </div>

        <button
            id="lightboxNext"
            type="button"
            class="absolute right-[15px] md:right-[30px] top-1/2 -translate-y-1/2 bg-white/10 text-white text-[1.5rem] md:text-[1.8rem] px-3.5 py-3 md:px-5 md:py-4 border-none cursor-pointer rounded hover:bg-[var(--accent-orange)] z-50"
        >
            &#10095;
        </button>
    </div>

    <script>
        (() => {
            const wrapper = document.getElementById('horizontalSliderWrapper') as HTMLElement | null;
            const track = document.getElementById('horizontalSlider') as HTMLElement | null;

            const sliderPrev = document.getElementById('sliderPrev') as HTMLButtonElement | null;
            const sliderNext = document.getElementById('sliderNext') as HTMLButtonElement | null;
            const sliderProgress = document.getElementById('sliderProgress') as HTMLElement | null;

            const modal = document.getElementById('lightboxModal');
            const modalImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
            const modalCaption = document.getElementById('lightboxCaption');
            const closeBtn = document.getElementById('lightboxClose');
            const lightboxPrev = document.getElementById('lightboxPrev');
            const lightboxNext = document.getElementById('lightboxNext');

            if (!wrapper || !track || !sliderPrev || !sliderNext || !sliderProgress) return;

            const galleryItems = Array.from(
                track.querySelectorAll<HTMLElement>('.gallery-item')
            );

            const imagesData = galleryItems.map(item => {
                const img = item.querySelector('img');

                return {
                    src: img?.getAttribute('src') || '',
                    alt: img?.getAttribute('alt') || ''
                };
            });

            const ANIMATION_DURATION = 380;
            const MIN_SWIPE_DISTANCE = 25;
            const VELOCITY_THRESHOLD = 0.15;
            const DIRECTION_THRESHOLD = 6;

            let snapPoints: number[] = [];
            let currentIndex = 0;
            let currentOffset = 0;

            let isDragging = false;
            let isHorizontalDrag = false;
            let activePointerId: number | null = null;

            let startX = 0;
            let startY = 0;
            let startTime = 0;
            let startOffset = 0;

            let suppressClick = false;
            let suppressClickTimer: ReturnType<typeof setTimeout> | null = null;

            let lightboxIndex = 0;

            let lightboxPointerId: number | null = null;
            let lightboxStartX = 0;
            let lightboxStartY = 0;
            let lightboxIsHorizontal = false;

            let touchStartX = 0;
            let touchStartY = 0;
            let touchStartTime = 0;
            let touchStartOffset = 0;
            let touchIsHorizontal = false;
            let isTouchDragging = false;

            let lightboxTouchStartX = 0;
            let lightboxTouchStartY = 0;
            let lightboxTouchIsHorizontal = false;

            track.style.transition = `transform ${ANIMATION_DURATION}ms cubic-bezier(0.22, 0.75, 0.25, 1)`;
            track.style.willChange = 'transform';

            wrapper.style.touchAction = 'pan-y';

            if (modalImg) {
                modalImg.style.touchAction = 'pan-y';
                modalImg.style.userSelect = 'none';
                modalImg.style.webkitUserSelect = 'none';
                modalImg.draggable = false;
            }

            function getMaxOffset() {
                return Math.max(0, track.scrollWidth - wrapper.clientWidth);
            }

            function buildSnapPoints() {
                snapPoints = galleryItems.map(item => {
                    const itemCenter = item.offsetLeft + item.offsetWidth / 2;
                    const targetOffset = itemCenter - wrapper.clientWidth / 2;

                    return Math.max(0, Math.min(targetOffset, getMaxOffset()));
                });

                snapPoints = snapPoints.filter((point, index) =>
                    index === 0 || point > snapPoints[index - 1] + 1
                );

                if (!snapPoints.length) {
                    snapPoints = [0];
                }

                currentIndex = Math.min(currentIndex, snapPoints.length - 1);
                currentOffset = snapPoints[currentIndex];

                updatePosition(false);
            }

            function updatePosition(animate = true) {
                track.style.transition = animate
                    ? `transform ${ANIMATION_DURATION}ms cubic-bezier(0.22, 0.75, 0.25, 1)`
                    : 'none';

                track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;

                updateSliderControls();
            }

            function updateSliderControls() {
                const total = snapPoints.length;

                const progress = total > 1
                    ? (currentIndex / (total - 1)) * 100
                    : 100;

                sliderProgress.style.width = `${progress}%`;

                sliderPrev.classList.toggle('text-gray-400', currentIndex <= 0);
                sliderPrev.classList.toggle('text-white', currentIndex > 0);

                sliderNext.classList.toggle('text-gray-400', currentIndex >= total - 1);
                sliderNext.classList.toggle('text-white', currentIndex < total - 1);

                sliderPrev.style.pointerEvents = currentIndex <= 0 ? 'none' : 'auto';
                sliderNext.style.pointerEvents = currentIndex >= total - 1 ? 'none' : 'auto';
            }

            function goToIndex(index: number, animate = true) {
                currentIndex = Math.max(0, Math.min(index, snapPoints.length - 1));
                currentOffset = snapPoints[currentIndex];

                updatePosition(animate);
            }

            function resetDragState() {
                isDragging = false;
                isHorizontalDrag = false;

                wrapper.classList.remove('is-dragging');

                track.style.transition = `transform ${ANIMATION_DURATION}ms cubic-bezier(0.22, 0.75, 0.25, 1)`;
            }

            function enableClickSuppression() {
                suppressClick = true;

                if (suppressClickTimer) {
                    clearTimeout(suppressClickTimer);
                }

                suppressClickTimer = setTimeout(() => {
                    suppressClick = false;
                    suppressClickTimer = null;
                }, 350);
            }

            function applyDragOffset(deltaX: number, baseOffset: number) {
                const maxOffset = getMaxOffset();
                let nextOffset = baseOffset - deltaX;

                if (nextOffset < 0) {
                    nextOffset *= 0.25;
                } else if (nextOffset > maxOffset) {
                    nextOffset = maxOffset + (nextOffset - maxOffset) * 0.25;
                }

                currentOffset = nextOffset;

                track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;
            }

            function finishTouchDrag() {
                if (!isTouchDragging) return;

                const dragDistance = currentOffset - touchStartOffset;
                const dragDuration = Math.max(1, performance.now() - touchStartTime);
                const finalVelocity = Math.abs(dragDistance) / dragDuration;

                if (touchIsHorizontal) {
                    if (
                        Math.abs(dragDistance) >= MIN_SWIPE_DISTANCE ||
                        finalVelocity >= VELOCITY_THRESHOLD
                    ) {
                        const direction = dragDistance > 0 ? 1 : -1;
                        goToIndex(currentIndex + direction);
                    } else {
                        goToIndex(currentIndex);
                    }

                    enableClickSuppression();
                } else {
                    goToIndex(currentIndex);
                }

                isTouchDragging = false;
                touchIsHorizontal = false;

                resetDragState();
            }

            wrapper.addEventListener('touchstart', (event: TouchEvent) => {
                if (event.touches.length !== 1) return;
                if (snapPoints.length <= 1) return;
                if ((event.target as HTMLElement).closest('button')) return;

                const touch = event.touches[0];

                isTouchDragging = true;
                touchIsHorizontal = false;

                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                touchStartTime = performance.now();
                touchStartOffset = currentOffset;

                track.style.transition = 'none';
            }, { passive: true });

            wrapper.addEventListener('touchmove', (event: TouchEvent) => {
                if (!isTouchDragging || event.touches.length !== 1) return;

                const touch = event.touches[0];
                const deltaX = touch.clientX - touchStartX;
                const deltaY = touch.clientY - touchStartY;

                if (!touchIsHorizontal) {
                    if (
                        Math.abs(deltaX) < DIRECTION_THRESHOLD &&
                        Math.abs(deltaY) < DIRECTION_THRESHOLD
                    ) {
                        return;
                    }

                    if (Math.abs(deltaY) > Math.abs(deltaX)) {
                        isTouchDragging = false;
                        resetDragState();
                        return;
                    }

                    touchIsHorizontal = true;
                    isDragging = true;

                    wrapper.classList.add('is-dragging');
                }

                if (event.cancelable) {
                    event.preventDefault();
                }

                applyDragOffset(deltaX, touchStartOffset);
            }, { passive: false });

            wrapper.addEventListener('touchend', () => {
                finishTouchDrag();
            });

            wrapper.addEventListener('touchcancel', () => {
                if (!isTouchDragging) return;

                isTouchDragging = false;
                touchIsHorizontal = false;

                resetDragState();
                goToIndex(currentIndex);
            });

            wrapper.addEventListener('pointerdown', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (event.pointerType === 'mouse' && event.button !== 0) return;
                if ((event.target as HTMLElement).closest('button')) return;
                if (snapPoints.length <= 1) return;

                isDragging = true;
                isHorizontalDrag = false;
                activePointerId = event.pointerId;

                startX = event.clientX;
                startY = event.clientY;
                startTime = performance.now();
                startOffset = currentOffset;

                track.style.transition = 'none';
            });

            wrapper.addEventListener('pointermove', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (!isDragging || event.pointerId !== activePointerId) return;

                const deltaX = event.clientX - startX;
                const deltaY = event.clientY - startY;

                if (!isHorizontalDrag) {
                    if (
                        Math.abs(deltaX) < DIRECTION_THRESHOLD &&
                        Math.abs(deltaY) < DIRECTION_THRESHOLD
                    ) {
                        return;
                    }

                    if (Math.abs(deltaY) > Math.abs(deltaX)) {
                        activePointerId = null;
                        resetDragState();
                        return;
                    }

                    isHorizontalDrag = true;
                    wrapper.classList.add('is-dragging');
                    wrapper.setPointerCapture(event.pointerId);
                }

                if (event.cancelable) {
                    event.preventDefault();
                }

                applyDragOffset(deltaX, startOffset);
            });

            function finishDragging(pointerId: number) {
                if (!isDragging || pointerId !== activePointerId) return;

                const dragDistance = currentOffset - startOffset;
                const dragDuration = Math.max(1, performance.now() - startTime);
                const finalVelocity = Math.abs(dragDistance) / dragDuration;

                if (isHorizontalDrag) {
                    if (
                        Math.abs(dragDistance) >= MIN_SWIPE_DISTANCE ||
                        finalVelocity >= VELOCITY_THRESHOLD
                    ) {
                        const direction = dragDistance > 0 ? 1 : -1;
                        goToIndex(currentIndex + direction);
                    } else {
                        goToIndex(currentIndex);
                    }

                    enableClickSuppression();
                } else {
                    goToIndex(currentIndex);
                }

                const capturedPointer = activePointerId;
                activePointerId = null;

                resetDragState();

                if (
                    capturedPointer !== null &&
                    wrapper.hasPointerCapture(capturedPointer)
                ) {
                    wrapper.releasePointerCapture(capturedPointer);
                }
            }

            wrapper.addEventListener('pointerup', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                finishDragging(event.pointerId);
            });

            wrapper.addEventListener('pointercancel', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (event.pointerId !== activePointerId) return;

                const pointerId = activePointerId;
                activePointerId = null;

                resetDragState();
                goToIndex(currentIndex);

                if (
                    pointerId !== null &&
                    wrapper.hasPointerCapture(pointerId)
                ) {
                    wrapper.releasePointerCapture(pointerId);
                }
            });

            wrapper.addEventListener('lostpointercapture', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (event.pointerId !== activePointerId) return;

                activePointerId = null;

                resetDragState();
                goToIndex(currentIndex);
            });

            wrapper.addEventListener('click', (event: MouseEvent) => {
                if (suppressClick) {
                    event.preventDefault();
                    event.stopPropagation();
                    suppressClick = false;

                    if (suppressClickTimer) {
                        clearTimeout(suppressClickTimer);
                        suppressClickTimer = null;
                    }
                }
            }, true);

            track.addEventListener('dragstart', event => {
                event.preventDefault();
            });

            sliderPrev.addEventListener('click', () => {
                goToIndex(currentIndex - 1);
            });

            sliderNext.addEventListener('click', () => {
                goToIndex(currentIndex + 1);
            });

            function showLightboxImage(index: number) {
                if (!imagesData.length || !modalImg || !modalCaption) return;

                lightboxIndex = (index + imagesData.length) % imagesData.length;

                modalImg.src = imagesData[lightboxIndex].src;
                modalImg.alt = imagesData[lightboxIndex].alt;
                modalCaption.textContent = imagesData[lightboxIndex].alt;
            }

            function openModal(index: number) {
                if (!modal) return;

                showLightboxImage(index);

                modal.classList.remove('hidden');
                modal.classList.add('flex');

                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                if (!modal) return;

                modal.classList.remove('flex');
                modal.classList.add('hidden');

                document.body.style.overflow = '';

                lightboxPointerId = null;
                lightboxIsHorizontal = false;
                lightboxTouchIsHorizontal = false;
            }

            modalImg?.addEventListener('touchstart', (event: TouchEvent) => {
                if (event.touches.length !== 1) return;

                const touch = event.touches[0];

                lightboxTouchStartX = touch.clientX;
                lightboxTouchStartY = touch.clientY;
                lightboxTouchIsHorizontal = false;
            }, { passive: true });

            modalImg?.addEventListener('touchmove', (event: TouchEvent) => {
                if (event.touches.length !== 1) return;

                const touch = event.touches[0];
                const deltaX = touch.clientX - lightboxTouchStartX;
                const deltaY = touch.clientY - lightboxTouchStartY;

                if (!lightboxTouchIsHorizontal) {
                    if (Math.abs(deltaX) < 8 && Math.abs(deltaY) < 8) return;

                    if (Math.abs(deltaY) > Math.abs(deltaX)) {
                        lightboxTouchIsHorizontal = false;
                        return;
                    }

                    lightboxTouchIsHorizontal = true;
                }

                if (event.cancelable) {
                    event.preventDefault();
                }
            }, { passive: false });

            modalImg?.addEventListener('touchend', (event: TouchEvent) => {
                if (!lightboxTouchIsHorizontal) return;

                const touch = event.changedTouches[0];
                const deltaX = touch.clientX - lightboxTouchStartX;

                lightboxTouchIsHorizontal = false;

                if (Math.abs(deltaX) < 45) return;

                if (deltaX < 0) {
                    showLightboxImage(lightboxIndex + 1);
                } else {
                    showLightboxImage(lightboxIndex - 1);
                }
            });

            modalImg?.addEventListener('touchcancel', () => {
                lightboxTouchIsHorizontal = false;
            });

            modalImg?.addEventListener('pointerdown', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (event.pointerType === 'mouse' && event.button !== 0) return;

                lightboxPointerId = event.pointerId;
                lightboxStartX = event.clientX;
                lightboxStartY = event.clientY;
                lightboxIsHorizontal = false;
            });

            modalImg?.addEventListener('pointermove', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;
                if (event.pointerId !== lightboxPointerId) return;

                const deltaX = event.clientX - lightboxStartX;
                const deltaY = event.clientY - lightboxStartY;

                if (!lightboxIsHorizontal) {
                    if (Math.abs(deltaX) < 8 && Math.abs(deltaY) < 8) return;

                    if (Math.abs(deltaY) > Math.abs(deltaX)) {
                        lightboxPointerId = null;
                        return;
                    }

                    lightboxIsHorizontal = true;
                    modalImg?.setPointerCapture(event.pointerId);
                }

                if (event.cancelable) {
                    event.preventDefault();
                }
            });

            function finishLightboxSwipe(event: PointerEvent) {
                if (event.pointerType === 'touch') return;
                if (event.pointerId !== lightboxPointerId) return;

                const deltaX = event.clientX - lightboxStartX;
                const wasHorizontal = lightboxIsHorizontal;

                lightboxPointerId = null;
                lightboxIsHorizontal = false;

                if (!wasHorizontal || Math.abs(deltaX) < 45) return;

                if (deltaX < 0) {
                    showLightboxImage(lightboxIndex + 1);
                } else {
                    showLightboxImage(lightboxIndex - 1);
                }
            }

            modalImg?.addEventListener('pointerup', finishLightboxSwipe);

            modalImg?.addEventListener('pointercancel', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;

                lightboxPointerId = null;
                lightboxIsHorizontal = false;
            });

            modalImg?.addEventListener('lostpointercapture', (event: PointerEvent) => {
                if (event.pointerType === 'touch') return;

                lightboxPointerId = null;
                lightboxIsHorizontal = false;
            });

            galleryItems.forEach((item, index) => {
                item.addEventListener('click', () => {
                    if (suppressClick) return;

                    openModal(index);
                });
            });

            closeBtn?.addEventListener('click', closeModal);

            lightboxPrev?.addEventListener('click', event => {
                event.stopPropagation();
                showLightboxImage(lightboxIndex - 1);
            });

            lightboxNext?.addEventListener('click', event => {
                event.stopPropagation();
                showLightboxImage(lightboxIndex + 1);
            });

            modal?.addEventListener('click', event => {
                if (event.target === modal) {
                    closeModal();
                }
            });

            document.addEventListener('keydown', event => {
                if (!modal || modal.classList.contains('hidden')) return;

                if (event.key === 'Escape') {
                    closeModal();
                }

                if (event.key === 'ArrowLeft') {
                    showLightboxImage(lightboxIndex - 1);
                }

                if (event.key === 'ArrowRight') {
                    showLightboxImage(lightboxIndex + 1);
                }
            });

            let resizeTimer: ReturnType<typeof setTimeout>;

            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);

                resizeTimer = setTimeout(() => {
                    buildSnapPoints();
                }, 100);
            });

            buildSnapPoints();
        })();
    </script>
</Layout>