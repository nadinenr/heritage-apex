---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');

const commercialProjects = allProjects
    .filter(project => project.data.category?.toUpperCase() === 'COMMERCIAL')
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout
    title="Commercial & Corporate Architecture in Muscat | HERITAGE APEX"
    description="Professional commercial architecture, office, and corporate space design services in Muscat, Oman."
>
    <section class="relative w-full min-h-[calc(100vh-90px)] bg-[var(--darker-brown)] pt-18 pb-8 overflow-hidden">

        <div
            class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-10 mix-blend-luminosity pointer-events-none z-0"
            style="background-image: url('/images/background.jpg');"
            aria-hidden="true"
        ></div>

        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--darker-brown)] pointer-events-none z-0"></div>

        <div class="relative z-10 max-w-[1450px] w-full mx-auto px-[4%] md:px-[5%]">

            <div class="mb-[25px]">
                <div class="flex items-center gap-[15px] mb-[10px] text-[12px] tracking-[3px] uppercase font-semibold text-[var(--accent-orange)]">
                    <span>PORTFOLIO CATEGORY</span>
                    <i class="w-[50px] h-[1px] bg-[var(--accent-orange)]"></i>
                </div>

                <h1 class="text-[2.5rem] md:text-[3.5rem] font-extrabold leading-tight text-white">
                    Commercial Projects
                </h1>
            </div>

            <div
                id="sliderWrapper"
                class="drag-slider-wrapper relative w-full pb-4 overflow-hidden"
            >
                <div
                    id="slider-track"
                    class="drag-slider-track flex gap-[35px] w-max pt-5 cursor-grab mx-auto"
                >
                    {commercialProjects.map((project) => (
                        <a
                            href={`/projects/${project.id}`}
                            draggable="false"
                            class="commercial-slide drag-slider-item group w-[350px] md:w-[380px] bg-[#352f2a]/90 backdrop-blur-sm rounded-[10px] overflow-hidden shadow-lg no-underline shrink-0 transition-transform duration-300 hover:-translate-y-2 border border-white/10 select-none"
                        >
                            <div class="w-full h-[220px] sm:h-[240px] overflow-hidden pointer-events-none">
                                <img
                                    src={project.data.gallery?.[0] || '/images/about-2.jpg'}
                                    alt={project.data.title}
                                    draggable="false"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none"
                                />
                            </div>

                            <div class="p-[22px] pointer-events-none">
                                <span class="text-[12px] tracking-[2px] font-bold block mb-[6px] text-[var(--accent-orange)]">
                                    {project.data.category}
                                </span>

                                <h3 class="text-[1.2rem] font-bold text-white group-hover:text-[var(--accent-orange)] transition-colors">
                                    {project.data.title}
                                </h3>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

            <div class="flex items-center justify-end mt-[40px]">
                <div class="flex items-center gap-[18px]">

                    <button
                        id="prev-btn"
                        type="button"
                        class="text-[11px] tracking-[2.5px] font-bold text-white/50 hover:text-white transition-colors cursor-pointer uppercase select-none"
                    >
                        PREV.
                    </button>

                    <div class="w-[100px] sm:w-[130px] h-[2px] bg-white/15 relative overflow-hidden">
                        <div
                            id="progress-bar"
                            class="absolute top-0 left-0 h-full bg-[var(--accent-orange)] transition-all duration-300"
                            style="width: 100%"
                        ></div>
                    </div>

                    <button
                        id="next-btn"
                        type="button"
                        class="text-[11px] tracking-[2.5px] font-bold text-white hover:text-white transition-colors cursor-pointer uppercase select-none"
                    >
                        NEXT
                    </button>

                </div>
            </div>

        </div>
    </section>

    <script>
        const wrapper = document.getElementById('sliderWrapper') as HTMLElement;
        const track = document.getElementById('slider-track') as HTMLElement;
        const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
        const progressBar = document.getElementById('progress-bar') as HTMLElement;

        if (wrapper && track && prevBtn && nextBtn && progressBar) {
            const cards = Array.from(
                track.querySelectorAll<HTMLElement>('.commercial-slide')
            );

            const ANIMATION_DURATION = 420;
            const DIRECTION_THRESHOLD = 8;
            const MIN_SWIPE_DISTANCE = 35;
            const VELOCITY_THRESHOLD = 0.35;

            let currentIndex = 0;
            let startX = 0;
            let startY = 0;
            let lastPointerX = 0;
            let startTime = 0;
            let startOffset = 0;
            let currentOffset = 0;

            let isDragging = false;
            let isHorizontalGesture = false;
            let activePointerId: number | null = null;
            let suppressClick = false;
            let clickResetTimer: number | undefined;

            let snapPoints: number[] = [];

            function getMaxOffset() {
                return Math.max(0, track.scrollWidth - wrapper.clientWidth);
            }

            function buildSnapPoints() {
                const maxOffset = getMaxOffset();

                const points = cards.map(card =>
                    Math.min(card.offsetLeft, maxOffset)
                );

                snapPoints = points.filter((point, index) =>
                    index === 0 || point > points[index - 1] + 1
                );

                if (!snapPoints.length) {
                    snapPoints = [0];
                }

                currentIndex = Math.min(currentIndex, snapPoints.length - 1);
                currentOffset = snapPoints[currentIndex];
            }

            function updateProgress() {
                const total = snapPoints.length;

                const progress = total > 1
                    ? ((currentIndex + 1) / total) * 100
                    : 100;

                progressBar.style.width = `${progress}%`;

                prevBtn.style.opacity = currentIndex === 0 ? '0.4' : '1';
                nextBtn.style.opacity = currentIndex >= total - 1 ? '0.4' : '1';

                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= total - 1;
            }

            function moveToIndex(index: number, smooth = true) {
                currentIndex = Math.max(
                    0,
                    Math.min(index, snapPoints.length - 1)
                );

                currentOffset = snapPoints[currentIndex];

                track.style.transition = smooth
                    ? `transform ${ANIMATION_DURATION}ms cubic-bezier(0.22, 0.75, 0.25, 1)`
                    : 'none';

                track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;

                updateProgress();
            }

            function resetDragState() {
                isDragging = false;
                isHorizontalGesture = false;
                activePointerId = null;

                wrapper.classList.remove('is-dragging');
            }

            function finishDragging(cancelled = false) {
                if (!isDragging) return;

                const pointerId = activePointerId;
                const wasHorizontal = isHorizontalGesture;

                const deltaX = startX - lastPointerX;
                const distance = Math.abs(deltaX);
                const duration = Math.max(1, performance.now() - startTime);
                const velocity = distance / duration;

                resetDragState();

                if (
                    pointerId !== null &&
                    wrapper.hasPointerCapture(pointerId)
                ) {
                    wrapper.releasePointerCapture(pointerId);
                }

                if (cancelled || !wasHorizontal) {
                    moveToIndex(currentIndex);
                    return;
                }

                const shouldMove =
                    distance >= MIN_SWIPE_DISTANCE ||
                    (
                        distance >= DIRECTION_THRESHOLD &&
                        velocity >= VELOCITY_THRESHOLD
                    );

                if (shouldMove) {
                    moveToIndex(currentIndex + (deltaX > 0 ? 1 : -1));
                } else {
                    moveToIndex(currentIndex);
                }

                if (distance >= DIRECTION_THRESHOLD) {
                    suppressClick = true;

                    window.clearTimeout(clickResetTimer);

                    clickResetTimer = window.setTimeout(() => {
                        suppressClick = false;
                    }, 250);
                }
            }

            wrapper.addEventListener('pointerdown', (event: PointerEvent) => {
                if (event.pointerType === 'mouse' && event.button !== 0) return;
                if (snapPoints.length <= 1 || isDragging) return;

                isDragging = true;
                isHorizontalGesture = false;
                activePointerId = event.pointerId;

                startX = event.clientX;
                startY = event.clientY;
                lastPointerX = event.clientX;
                startTime = performance.now();
                startOffset = currentOffset;

                track.style.transition = 'none';
                wrapper.classList.add('is-dragging');
            });

            wrapper.addEventListener('pointermove', (event: PointerEvent) => {
                if (!isDragging || event.pointerId !== activePointerId) return;

                const deltaX = event.clientX - startX;
                const deltaY = event.clientY - startY;

                lastPointerX = event.clientX;

                if (!isHorizontalGesture) {
                    if (
                        Math.abs(deltaX) < DIRECTION_THRESHOLD &&
                        Math.abs(deltaY) < DIRECTION_THRESHOLD
                    ) {
                        return;
                    }

                    if (Math.abs(deltaY) > Math.abs(deltaX)) {
                        resetDragState();
                        return;
                    }

                    isHorizontalGesture = true;
                    wrapper.setPointerCapture(event.pointerId);
                }

                event.preventDefault();

                const maxOffset = getMaxOffset();
                let nextOffset = startOffset - deltaX;

                if (nextOffset < 0) {
                    nextOffset *= 0.25;
                } else if (nextOffset > maxOffset) {
                    nextOffset = maxOffset + (nextOffset - maxOffset) * 0.25;
                }

                currentOffset = nextOffset;

                track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;
            });

            wrapper.addEventListener('pointerup', (event: PointerEvent) => {
                if (event.pointerId !== activePointerId) return;
                finishDragging();
            });

            wrapper.addEventListener('pointercancel', (event: PointerEvent) => {
                if (event.pointerId !== activePointerId) return;
                finishDragging(true);
            });

            wrapper.addEventListener('lostpointercapture', (event: PointerEvent) => {
                if (event.pointerId === activePointerId && isDragging) {
                    finishDragging(true);
                }
            });

            cards.forEach(card => {
                card.addEventListener('dragstart', event => {
                    event.preventDefault();
                });

                card.addEventListener('click', event => {
                    if (suppressClick) {
                        event.preventDefault();
                        event.stopPropagation();

                        suppressClick = false;
                        window.clearTimeout(clickResetTimer);
                    }
                });
            });

            nextBtn.addEventListener('click', () => {
                if (!isDragging) {
                    moveToIndex(currentIndex + 1);
                }
            });

            prevBtn.addEventListener('click', () => {
                if (!isDragging) {
                    moveToIndex(currentIndex - 1);
                }
            });

            function refreshSlider() {
                buildSnapPoints();
                moveToIndex(currentIndex, false);
            }

            window.addEventListener('resize', refreshSlider);

            refreshSlider();
        }
    </script>
</Layout>