---
/**
 * Page: Exhibition Booths Portfolio (booths.astro)
 * Description: Displays a filtered showcase of booth projects with slider controls and responsive layout.
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch and filter projects category matching 'BOOTHS' ordered by index
const allProjects = await getCollection('projects');
const boothProjects = allProjects
    .filter(project => project.data.category?.toUpperCase() === 'BOOTHS')
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Exhibition Booth Design & Fit-Out in Muscat | HERITAGE APEX" 
    description="Creative exhibition stands, display booths, and event fit-out contractor services in Muscat, Oman.">
    
    <!-- Section styled with balanced top padding matching the rest of the portfolio pages -->
    <section class="relative w-full min-h-[calc(100vh-90px)] bg-[var(--darker-brown)] pt-18 pb-8 overflow-hidden">
        
        <!-- Background Image Layer -->
        <div 
            class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-10 mix-blend-luminosity pointer-events-none z-0"
            style="background-image: url('/images/background.jpg');"
            aria-hidden="true"
        ></div>

        <!-- Bottom Gradient Blend -->
        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--darker-brown)] pointer-events-none z-0"></div>

        <!-- Main Content Container -->
        <div class="relative z-10 max-w-[1450px] w-full mx-auto px-[4%] md:px-[5%]">
            
            <!-- Page Header -->
            <div class="mb-[25px]">
                <div class="flex items-center gap-[15px] mb-[10px] text-[12px] tracking-[3px] uppercase font-semibold text-[var(--accent-orange)]">
                    <span>PORTFOLIO CATEGORY</span>
                    <i class="w-[50px] h-[1px] bg-[var(--accent-orange)]"></i>
                </div>
                <h1 class="text-[2.5rem] md:text-[3.5rem] font-extrabold leading-tight text-white">Exhibition Booths</h1>
            </div>

            <!-- Horizontal Slider Container -->
            <div class="relative overflow-hidden w-full">
                <div id="slider-track" class="flex gap-[35px] transition-transform duration-500 ease-out will-change-transform pt-5">
                    {boothProjects.map((project) => (
                        <a href={`/projects/${project.id}`} class="group w-full md:w-[calc(50%-17.5px)] lg:w-[calc(33.333%-23.33px)] bg-[#352f2a]/90 backdrop-blur-sm rounded-[10px] overflow-hidden shadow-lg no-underline flex-shrink-0 transition-transform duration-300 hover:-translate-y-2 border border-white/10">
                            <!-- Project Image Box -->
                            <div class="w-full h-[220px] sm:h-[240px] overflow-hidden">
                                <img 
                                    src={project.data.gallery && project.data.gallery.length > 0 ? project.data.gallery[0] : '/images/about-2.jpg'} 
                                    alt={project.data.title} 
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                />
                            </div>
                            <!-- Project Content Box -->
                            <div class="p-[22px]">
                                <span class="text-[12px] tracking-[2px] font-bold block mb-[6px] text-[var(--accent-orange)]">{project.data.category}</span>
                                <h3 class="text-[1.2rem] font-bold text-white group-hover:text-[var(--accent-orange)] transition-colors">{project.data.title}</h3>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

            <!-- Navigation Buttons and Progress Bar Controls -->
            <div class="flex items-center justify-end mt-[40px]">
                <div class="flex items-center gap-[18px]">
                    <button id="prev-btn" type="button" class="text-[11px] tracking-[2.5px] font-bold text-white/50 hover:text-white transition-colors cursor-pointer uppercase select-none">
                        PREV.
                    </button>
                    <div class="w-[100px] sm:w-[130px] h-[2px] bg-white/15 relative overflow-hidden">
                        <div id="progress-bar" class="absolute top-0 left-0 h-full bg-[var(--accent-orange)] transition-all duration-300" style="width: 35%"></div>
                    </div>
                    <button id="next-btn" type="button" class="text-[11px] tracking-[2.5px] font-bold text-white hover:text-white transition-colors cursor-pointer uppercase select-none">
                        NEXT
                    </button>
                </div>
            </div>

        </div>
    </section>

    <script is:inline>
        /**
         * Booths Portfolio Slider Script
         * Manages track movement, responsive column offsets, button opacity states, and progress bar width.
         */
        document.addEventListener('DOMContentLoaded', () => {
            const track = document.getElementById('slider-track');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const progressBar = document.getElementById('progress-bar');

            if (!track || !prevBtn || !nextBtn || !progressBar) return;

            const cards = Array.from(track.children);
            let currentIndex = 0;

            function getVisibleCards() {
                if (window.innerWidth >= 1024) return 3;
                if (window.innerWidth >= 768) return 2;
                return 1;
            }

            function getMaxIndex() {
                return Math.max(0, cards.length - getVisibleCards());
            }

            function updateSlider() {
                if (!cards.length) return;
                const maxIndex = getMaxIndex();
                currentIndex = Math.min(currentIndex, maxIndex);

                const cardWidth = cards[0].getBoundingClientRect().width;
                const gap = 35;
                const moveAmount = currentIndex * (cardWidth + gap);
                track.style.transform = `translateX(-${moveAmount}px)`;

                const progressPercent = maxIndex > 0 ? 35 + (currentIndex / maxIndex) * 65 : 35;
                progressBar.style.width = `${progressPercent}%`;

                prevBtn.style.opacity = currentIndex === 0 ? '0.4' : '1';
                nextBtn.style.opacity = currentIndex >= maxIndex ? '0.4' : '1';

                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= maxIndex;
            }

            nextBtn.addEventListener('click', () => {
                if (currentIndex < getMaxIndex()) {
                    currentIndex++;
                    updateSlider();
                }
            });

            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                    updateSlider();
                }
            });

            window.addEventListener('resize', updateSlider);
            updateSlider();
        });
    </script>
</Layout>