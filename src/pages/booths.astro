---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const boothProjects = allProjects
    .filter(project => project.data.category?.toUpperCase() === 'BOOTHS')
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Exhibition Booth Design & Fit-Out in Muscat | HERITAGE APEX" 
    description="Creative exhibition stands, display booths, and event fit-out contractor services in Muscat, Oman.">
    
    <section class="relative w-full min-h-[calc(100vh-90px)] bg-[var(--darker-brown)] pt-18 pb-8 overflow-hidden">
        
        <!-- Background image overlay with luminosity effect -->
        <div 
            class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-10 mix-blend-luminosity pointer-events-none z-0"
            style="background-image: url('/images/background.jpg');"
            aria-hidden="true"
        ></div>

        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--darker-brown)] pointer-events-none z-0"></div>

        <div class="relative z-10 max-w-[1450px] w-full mx-auto px-[4%] md:px-[5%]">
            
            <div class="mb-[25px]">
                <div class="flex items-center gap-[15px] mb-[10px] text-[12px] tracking-[3px] uppercase font-semibold text-[var(--accent-orange)]">
                    <span>PORTFOLIO CATEGORY</span>
                    <i class="w-[50px] h-[1px] bg-[var(--accent-orange)]"></i>
                </div>
                <h1 class="text-[2.5rem] md:text-[3.5rem] font-extrabold leading-tight text-white">Exhibition Booths</h1>
            </div>

            <!-- Momentum slider wrapper supporting native smooth touch navigation -->
            <div class="overflow-x-auto no-scrollbar momentum-slider cursor-grab relative w-full pb-4" id="sliderWrapper">
                <div id="slider-track" class="flex gap-[35px] w-max pt-5 cursor-grab active:cursor-grabbing">
                    {boothProjects.map((project) => (
                        <a href={`/projects/${project.id}`} class="group w-[350px] md:w-[380px] bg-[#352f2a]/90 backdrop-blur-sm rounded-[10px] overflow-hidden shadow-lg no-underline flex-shrink-0 transition-transform duration-300 hover:-translate-y-2 border border-white/10 select-none">
                            <div class="w-full h-[220px] sm:h-[240px] overflow-hidden pointer-events-none">
                                <img 
                                    src={project.data.gallery && project.data.gallery.length > 0 ? project.data.gallery[0] : '/images/about-2.jpg'} 
                                    alt={project.data.title} 
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none" 
                                />
                            </div>
                            <div class="p-[22px] pointer-events-none">
                                <span class="text-[12px] tracking-[2px] font-bold block mb-[6px] text-[var(--accent-orange)]">{project.data.category}</span>
                                <h3 class="text-[1.2rem] font-bold text-white group-hover:text-[var(--accent-orange)] transition-colors">{project.data.title}</h3>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

            <!-- Slider navigation buttons and progress indicator controls -->
            <div class="flex items-center justify-end mt-[40px]">
                <div class="flex items-center gap-[18px]">
                    <button id="prev-btn" type="button" class="text-[11px] tracking-[2.5px] font-bold text-white/50 hover:text-white transition-colors cursor-pointer uppercase select-none">
                        PREV.
                    </button>
                    <div class="w-[100px] sm:w-[130px] h-[2px] bg-white/15 relative overflow-hidden">
                        <div id="progress-bar" class="absolute top-0 left-0 h-full bg-[var(--accent-orange)] transition-all duration-300" style="width: 35%"></div>
                    </div>
                    <button id="next-btn" type="button" class="text-[11px] tracking-[2.5px] font-bold text-white hover:text-white transition-colors cursor-pointer uppercase select-none">
                        NEXT
                    </button>
                </div>
            </div>

        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper = document.getElementById('sliderWrapper');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const progressBar = document.getElementById('progress-bar');

            if (!wrapper || !prevBtn || !nextBtn || !progressBar) return;

            const cards = wrapper.querySelectorAll('a');

            // Update progress bar width smoothly based on native horizontal scroll position
            function updateProgress() {
                const scrollLeft = wrapper.scrollLeft;
                const maxScrollLeft = wrapper.scrollWidth - wrapper.clientWidth;
                const progress = maxScrollLeft > 0 ? (scrollLeft / maxScrollLeft) * 100 : 0;
                progressBar.style.width = `${Math.max(35, progress)}%`;

                prevBtn.style.opacity = scrollLeft <= 5 ? '0.4' : '1';
                nextBtn.style.opacity = scrollLeft >= maxScrollLeft - 5 ? '0.4' : '1';
            }

            // Scroll forward smoothly by one card width plus gap
            nextBtn.addEventListener('click', () => {
                if (cards.length > 0) {
                    const cardWidth = cards[0].offsetWidth + 35;
                    wrapper.scrollBy({ left: cardWidth, behavior: 'smooth' });
                }
            });

            // Scroll backward smoothly by one card width plus gap
            prevBtn.addEventListener('click', () => {
                if (cards.length > 0) {
                    const cardWidth = cards[0].offsetWidth + 35;
                    wrapper.scrollBy({ left: -cardWidth, behavior: 'smooth' });
                }
            });

            wrapper.addEventListener('scroll', updateProgress);

            // Prevent dragging gestures from accidentally triggering link navigation clicks
            let startX = 0;
            let startY = 0;
            let isMoving = false;

            cards.forEach((card) => {
                card.addEventListener('pointerdown', (e) => {
                    startX = e.clientX;
                    startY = e.clientY;
                    isMoving = false;
                });

                card.addEventListener('pointermove', (e) => {
                    if (Math.abs(e.clientX - startX) > 5 || Math.abs(e.clientY - startY) > 5) {
                        isMoving = true;
                    }
                });

                card.addEventListener('click', (e) => {
                    if (isMoving) {
                        e.preventDefault();
                        return;
                    }
                });
            });

            updateProgress();
        });
    </script>
</Layout>