---
/**
 * Layout Component: Main Site Template
 */
import Navbar from '../components/Navbar.astro';
import MiniFooter from '../components/MiniFooter.astro';
import '../styles/global.css';

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const { 
    title = "HERITAGE APEX | Architecture & Interiors",
    description = "Where Experience Meets Creativity in Architecture and Interior Design.",
    image = "/images/about-2.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        html {
            overflow-x: hidden;
            overflow-y: auto;
            -webkit-text-size-adjust: 100%;
        }
        body {
            overflow-x: hidden;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        main {
            flex: 1;
        }
    </style>
</head>
<body class="bg-[var(--darker-brown)] text-white antialiased m-0 p-0 selection:bg-orange-500 selection:text-white">

    <Navbar />

    <main class="m-0 pt-[90px] px-0 pb-0 bg-[var(--darker-brown)]">
        <slot />
    </main>

    <MiniFooter />

    <!-- Pure JavaScript Touch & Mouse Momentum Scroll -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const sliders = document.querySelectorAll('.momentum-slider');

            sliders.forEach((slider) => {
                let isDown = false;
                let startX = 0;
                let scrollLeft = 0;

                // Mouse Events
                slider.addEventListener('mousedown', (e) => {
                    isDown = true;
                    slider.classList.add('cursor-grabbing');
                    slider.classList.remove('cursor-grab');
                    startX = e.pageX - slider.offsetLeft;
                    scrollLeft = slider.scrollLeft;
                });

                slider.addEventListener('mouseleave', () => {
                    isDown = false;
                    slider.classList.remove('cursor-grabbing');
                    slider.classList.add('cursor-grab');
                });

                slider.addEventListener('mouseup', () => {
                    isDown = false;
                    slider.classList.remove('cursor-grabbing');
                    slider.classList.add('cursor-grab');
                });

                slider.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - slider.offsetLeft;
                    const walk = (x - startX) * 1.5;
                    slider.scrollLeft = scrollLeft - walk;
                });

                // Touch Events for Mobile
                let touchStartX = 0;
                let touchScrollLeft = 0;

                slider.addEventListener('touchstart', (e) => {
                    touchStartX = e.touches[0].pageX;
                    touchScrollLeft = slider.scrollLeft;
                }, { passive: true });

                slider.addEventListener('touchmove', (e) => {
                    if (!touchStartX) return;
                    const x = e.touches[0].pageX;
                    const walk = (x - touchStartX) * 1.5;
                    slider.scrollLeft = touchScrollLeft - walk;
                }, { passive: true });

                slider.addEventListener('touchend', () => {
                    touchStartX = 0;
                });
            });
        });
    </script>
</body>
</html>