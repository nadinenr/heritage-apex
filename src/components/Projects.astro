---
const projects = [
    {
        title: 'Villas & Residential Portfolio',
        category: 'ARCHITECTURE',
        image: '/images/villa04.jpg',
        link: '/Villas'
    },
    {
        title: 'Commercial & Corporate Portfolio',
        category: 'COMMERCIAL',
        image: '/images/bnt elezz01.jpeg',
        link: '/commercial'
    },
    {
        title: 'Exhibition Booths Portfolio',
        category: 'BOOTHS',
        image: '/images/majd1.jpg',
        link: '/booths'
    }
];
---

<section id="projects" class="py-[120px] px-[8%] bg-[var(--dark-navy)] relative overflow-hidden">
    <!-- Background image overlay with subtle luminosity effect -->
    <div 
        class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-5 mix-blend-luminosity pointer-events-none"
        style="background-image: url('/images/background.jpg');"
    ></div>

    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--dark-navy)] pointer-events-none z-0"></div>

    <div class="max-w-[1300px] mx-auto relative z-10">
        <div class="mb-[60px]">
            <div class="flex items-center gap-[15px] mb-[15px] text-[12px] tracking-[3px] uppercase font-semibold text-[var(--accent-orange)]">
                <span>FEATURED PROJECTS</span>
                <i class="w-[50px] h-[1px] bg-[var(--accent-orange)]"></i>
            </div>
            <h2 class="text-[3rem] md:text-[3.5rem] font-extrabold text-white">Our Work</h2>
        </div>

        <!-- Momentum slider wrapper supporting native smooth touch navigation -->
        <div class="overflow-x-auto no-scrollbar momentum-slider cursor-grab relative pb-[10px]" id="projectsSliderWrapper">
            <div class="flex gap-[35px] w-max cursor-grab active:cursor-grabbing" id="projectsTrack">
                {projects.map((project) => (
                    <a href={project.link} class="min-w-[350px] md:min-w-[380px] flex-1 rounded-[16px] overflow-hidden shadow-xl no-underline group flex flex-col transition-transform duration-300 hover:-translate-y-2 border border-white/10 select-none">
                        <div class="w-full h-[260px] overflow-hidden pointer-events-none">
                            <img src={project.image} alt={project.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none" />
                        </div>
                        <div class="p-[30px] flex flex-col flex-grow bg-[var(--darker-brown)] backdrop-blur-sm pointer-events-none">
                            <span class="text-[11px] tracking-[2px] font-bold block mb-[12px] text-[var(--accent-orange)]">{project.category}</span>
                            <h3 class="text-[1.3rem] font-bold text-white group-hover:text-[var(--accent-orange)] transition-colors">{project.title}</h3>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- Slider navigation buttons and dynamic progress indicator -->
        <div class="flex justify-end items-center gap-[20px] mt-[50px]">
            <button type="button" id="prevBtn" class="text-xs font-bold tracking-[2px] text-white/50 hover:text-white transition-colors cursor-pointer uppercase select-none">PREV.</button>
            <div class="w-[120px] h-[2px] bg-white/15 relative overflow-hidden">
                <div class="absolute top-0 left-0 h-full bg-[var(--accent-orange)] transition-all duration-300" id="progressBar" style="width: 33%;"></div>
            </div>
            <button type="button" id="nextBtn" class="text-xs font-bold tracking-[2px] text-white hover:text-white transition-colors cursor-pointer uppercase select-none">NEXT</button>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const wrapper = document.getElementById('projectsSliderWrapper') as HTMLElement;
        const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
        const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
        const progressBar = document.getElementById('progressBar') as HTMLElement;

        if (!wrapper || !prevBtn || !nextBtn || !progressBar) return;

        const slides = wrapper.querySelectorAll('a');

        // Update progress bar width smoothly based on native horizontal scroll position
        function updateProgress() {
            const scrollLeft = wrapper.scrollLeft;
            const maxScrollLeft = wrapper.scrollWidth - wrapper.clientWidth;
            const progress = maxScrollLeft > 0 ? (scrollLeft / maxScrollLeft) * 100 : 0;
            progressBar.style.width = `${Math.max(33, progress)}%`;
        }

        // Scroll forward smoothly by one slide width plus gap
        nextBtn.addEventListener('click', () => {
            const slideWidth = (slides[0] as HTMLElement).offsetWidth + 35;
            wrapper.scrollBy({ left: slideWidth, behavior: 'smooth' });
        });

        // Scroll backward smoothly by one slide width plus gap
        prevBtn.addEventListener('click', () => {
            const slideWidth = (slides[0] as HTMLElement).offsetWidth + 35;
            wrapper.scrollBy({ left: -slideWidth, behavior: 'smooth' });
        });

        wrapper.addEventListener('scroll', updateProgress);

        // Prevent dragging gestures from accidentally triggering link navigation clicks
        let startX = 0;
        let startY = 0;
        let isMoving = false;

        slides.forEach((slide) => {
            slide.addEventListener('pointerdown', (e: any) => {
                startX = e.clientX;
                startY = e.clientY;
                isMoving = false;
            });

            slide.addEventListener('pointermove', (e: any) => {
                if (Math.abs(e.clientX - startX) > 5 || Math.abs(e.clientY - startY) > 5) {
                    isMoving = true;
                }
            });

            slide.addEventListener('click', (e) => {
                if (isMoving) {
                    e.preventDefault();
                    return;
                }
            });
        });
    });
</script>