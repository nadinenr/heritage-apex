---
const projects = [
    {
        title: 'Villas & Residential Portfolio',
        category: 'ARCHITECTURE',
        image: '/images/villa04.jpg',
        link: '/Villas'
    },
    {
        title: 'Commercial & Corporate Portfolio',
        category: 'COMMERCIAL',
        image: '/images/bnt elezz01.jpeg',
        link: '/commercial'
    },
    {
        title: 'Exhibition Booths Portfolio',
        category: 'BOOTHS',
        image: '/images/majd1.jpg',
        link: '/booths'
    }
];
---

<section id="projects" class="py-[120px] px-[8%] bg-[var(--dark-navy)] relative overflow-hidden">
    <div
        class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat opacity-5 mix-blend-luminosity pointer-events-none"
        style="background-image: url('/images/background.jpg');"
    ></div>

    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[var(--dark-navy)] pointer-events-none z-0"></div>

    <div class="max-w-[1300px] mx-auto relative z-10">
        <div class="mb-[60px]">
            <div class="flex items-center gap-[15px] mb-[15px] text-[12px] tracking-[3px] uppercase font-semibold text-[var(--accent-orange)]">
                <span>FEATURED PROJECTS</span>
                <i class="w-[50px] h-[1px] bg-[var(--accent-orange)]"></i>
            </div>
            <h2 class="text-[3rem] md:text-[3.5rem] font-extrabold text-white">Our Work</h2>
        </div>

        <div
            class="drag-slider-wrapper relative pb-[10px]"
            id="projectsSliderWrapper"
        >
            <div
                class="drag-slider-track flex gap-[35px] w-max cursor-grab"
                id="projectsTrack"
            >
                {projects.map((project) => (
                    <a
                        href={project.link}
                        draggable="false"
                        class="project-slide drag-slider-item w-[85vw] sm:w-[380px] md:w-[380px] shrink-0 rounded-[16px] overflow-hidden shadow-xl no-underline group flex flex-col transition-transform duration-300 hover:-translate-y-2 border border-white/10 select-none"
                    >
                        <div class="w-full h-[260px] overflow-hidden pointer-events-none">
                            <img
                                src={project.image}
                                alt={project.title}
                                draggable="false"
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none"
                            />
                        </div>

                        <div class="p-[30px] flex flex-col flex-grow bg-[var(--darker-brown)] backdrop-blur-sm pointer-events-none">
                            <span class="text-[11px] tracking-[2px] font-bold block mb-[12px] text-[var(--accent-orange)]">
                                {project.category}
                            </span>
                            <h3 class="text-[1.3rem] font-bold text-white group-hover:text-[var(--accent-orange)] transition-colors">
                                {project.title}
                            </h3>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- تم تعديل justify-end إلى justify-center للموبايل و md:justify-end للديسكتوب -->
        <div class="flex justify-center md:justify-end items-center gap-[20px] mt-[50px]">
            <button
                type="button"
                id="prevBtn"
                class="text-xs font-bold tracking-[2px] text-white/50 hover:text-white transition-colors cursor-pointer uppercase select-none"
            >
                PREV.
            </button>

            <div class="w-[120px] h-[2px] bg-white/15 relative overflow-hidden">
                <div
                    class="absolute top-0 left-0 h-full bg-[var(--accent-orange)] transition-all duration-300"
                    id="progressBar"
                    style="width: 33%;"
                ></div>
            </div>

            <button
                type="button"
                id="nextBtn"
                class="text-xs font-bold tracking-[2px] text-white hover:text-white transition-colors cursor-pointer uppercase select-none"
            >
                NEXT
            </button>
        </div>
    </div>
</section>

<script>
    const wrapper = document.getElementById('projectsSliderWrapper') as HTMLElement;
    const track = document.getElementById('projectsTrack') as HTMLElement;
    const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
    const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
    const progressBar = document.getElementById('progressBar') as HTMLElement;

    if (wrapper && track && prevBtn && nextBtn && progressBar) {
        const slides = Array.from(
            track.querySelectorAll<HTMLElement>('.project-slide')
        );

        const GAP = 35;
        const ANIMATION_DURATION = 380;
        const MIN_SWIPE_DISTANCE = 25;
        const VELOCITY_THRESHOLD = 0.15;

        let currentIndex = 0;
        let startX = 0;
        let startY = 0;
        let startTime = 0;
        let startOffset = 0;
        let currentOffset = 0;

        let isDragging = false;
        let isHorizontalGesture = false;
        let activePointerId: number | null = null;
        let suppressClick = false;
        let snapPoints: number[] = [];

        let clickResetTimer: number | undefined;

        function getMaxOffset() {
            return Math.max(0, track.scrollWidth - wrapper.clientWidth);
        }

        function buildSnapPoints() {
            const maxOffset = getMaxOffset();

            snapPoints = slides.map((slide) => {
                return Math.min(slide.offsetLeft, maxOffset);
            });

            snapPoints = snapPoints.filter((point, index) => {
                return index === 0 || point > snapPoints[index - 1] + 1;
            });

            if (!snapPoints.length) snapPoints = [0];

            currentIndex = Math.min(currentIndex, snapPoints.length - 1);
            currentOffset = snapPoints[currentIndex];
        }

        function updateProgress() {
            const total = snapPoints.length;

            const progress = total > 1
                ? ((currentIndex + 1) / total) * 100
                : 100;

            progressBar.style.width = `${progress}%`;

            prevBtn.style.opacity = currentIndex === 0 ? '0.4' : '1';
            nextBtn.style.opacity = currentIndex >= total - 1 ? '0.4' : '1';

            prevBtn.disabled = currentIndex === 0;
            nextBtn.disabled = currentIndex >= total - 1;
        }

        function moveToIndex(index: number, smooth = true) {
            currentIndex = Math.max(
                0,
                Math.min(index, snapPoints.length - 1)
            );

            currentOffset = snapPoints[currentIndex];

            track.style.transition = smooth
                ? `transform ${ANIMATION_DURATION}ms cubic-bezier(0.22, 0.75, 0.25, 1)`
                : 'none';

            track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;

            updateProgress();
        }

        function finishDragging() {
            if (!isDragging) return;

            isDragging = false;
            activePointerId = null;
            wrapper.classList.remove('is-dragging');

            const dragDistance = currentOffset - startOffset;
            const dragDuration = Math.max(1, performance.now() - startTime);
            const velocity = Math.abs(dragDistance) / dragDuration;

            if (isHorizontalGesture) {
                if (
                    Math.abs(dragDistance) >= MIN_SWIPE_DISTANCE ||
                    velocity >= VELOCITY_THRESHOLD
                ) {
                    const direction = dragDistance > 0 ? 1 : -1;
                    moveToIndex(currentIndex + direction);
                } else {
                    moveToIndex(currentIndex);
                }

                suppressClick = true;

                window.clearTimeout(clickResetTimer);

                clickResetTimer = window.setTimeout(() => {
                    suppressClick = false;
                }, 150);
            } else {
                moveToIndex(currentIndex);
            }

            isHorizontalGesture = false;
        }

        wrapper.addEventListener('pointerdown', (event: PointerEvent) => {
            if (event.pointerType === 'mouse' && event.button !== 0) return;
            if (snapPoints.length <= 1) return;
            if (isDragging) return;

            isDragging = true;
            isHorizontalGesture = false;
            activePointerId = event.pointerId;

            startX = event.clientX;
            startY = event.clientY;
            startTime = performance.now();
            startOffset = currentOffset;

            track.style.transition = 'none';
            wrapper.classList.add('is-dragging');
        });

        wrapper.addEventListener('pointermove', (event: PointerEvent) => {
            if (!isDragging || event.pointerId !== activePointerId) return;

            const deltaX = event.clientX - startX;
            const deltaY = event.clientY - startY;

            if (!isHorizontalGesture) {
                if (Math.abs(deltaX) < 6 && Math.abs(deltaY) < 6) return;

                if (Math.abs(deltaY) > Math.abs(deltaX)) {
                    isDragging = false;
                    activePointerId = null;
                    wrapper.classList.remove('is-dragging');
                    return;
                }

                isHorizontalGesture = true;
                wrapper.setPointerCapture(event.pointerId);
            }

            event.preventDefault();

            const maxOffset = getMaxOffset();
            let nextOffset = startOffset - deltaX;

            if (nextOffset < 0) {
                nextOffset = nextOffset * 0.25;
            } else if (nextOffset > maxOffset) {
                nextOffset = maxOffset + (nextOffset - maxOffset) * 0.25;
            }

            currentOffset = nextOffset;

            track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;
        });

        wrapper.addEventListener('pointerup', (event: PointerEvent) => {
            if (event.pointerId !== activePointerId) return;
            finishDragging();
        });

        wrapper.addEventListener('pointercancel', () => {
            finishDragging();
        });

        wrapper.addEventListener('lostpointercapture', () => {
            if (isDragging) finishDragging();
        });

        slides.forEach((slide) => {
            slide.addEventListener('dragstart', (event) => {
                event.preventDefault();
            });

            slide.addEventListener('click', (event) => {
                if (suppressClick) {
                    event.preventDefault();
                    event.stopPropagation();
                    suppressClick = false;
                    window.clearTimeout(clickResetTimer);
                }
            });
        });

        nextBtn.addEventListener('click', () => {
            if (!isDragging) {
                moveToIndex(currentIndex + 1);
            }
        });

        prevBtn.addEventListener('click', () => {
            if (!isDragging) {
                moveToIndex(currentIndex - 1);
            }
        });

        function refreshSlider() {
            buildSnapPoints();
            moveToIndex(currentIndex, false);
        }

        window.addEventListener('resize', refreshSlider);

        refreshSlider();
    }
</script>