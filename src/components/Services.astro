---
/**
 * Component: Services Accordion Section
 */
---

<section id="services" class="services-accordion-section">
    <h2 class="services-title">Our Services</h2>
    <div class="services-accordion" id="servicesAccordion">
        <!-- Shared Background Image Layer -->
        <div class="accordion-bg" id="accordionBg" style="background-image: url('/images/architecture.jpg');"></div>
        <div class="accordion-overlay"></div>

        <!-- Service Panel 1: Architecture -->
        <a href="/services/architecture" class="service-panel active" data-bg="/images/architecture.jpg">
            <div class="panel-content">
                <h3>Architecture</h3>
                <p>At HERITAGE, we specialize in delivering innovative architectural solutions through a highly skilled and dedicated team of professionals.</p>
            </div>
        </a>

        <!-- Service Panel 2: Interior Design -->
        <a href="/services/interior-design" class="service-panel" data-bg="/images/interior-design.jpg">
            <div class="panel-content">
                <h3>Interior Design</h3>
                <p>Bespoke interior concepts creating luxurious, functional, and aesthetically harmonious spaces.</p>
            </div>
        </a>

        <!-- Service Panel 3: Fit Out -->
        <a href="/services/fit-out" class="service-panel" data-bg="/images/fit-out.jpg">
            <div class="panel-content">
                <h3>Fit Out</h3>
                <p>High-end execution and seamless turnkey fit-out operations bringing concepts into reality.</p>
            </div>
        </a>

        <!-- Service Panel 4: Trading -->
        <a href="/services/trading" class="service-panel" data-bg="/images/creative-solutions.jpg">
            <div class="panel-content">
                <h3>Trading</h3>
                <p>Tailored design strategies and innovative spatial planning for unique architectural challenges.</p>
            </div>
        </a>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const panels = document.querySelectorAll('.service-panel');
        const accordionBg = document.getElementById('accordionBg');

        panels.forEach(panel => {
            // Handle desktop hover interactions
            panel.addEventListener('mouseenter', () => {
                if (window.innerWidth > 768) {
                    panels.forEach(p => p.classList.remove('active'));
                    panel.classList.add('active');

                    const bgImage = panel.getAttribute('data-bg');
                    if (accordionBg && bgImage) {
                        accordionBg.style.backgroundImage = `url('${bgImage}')`;
                    }
                }
            });

            // Handle mobile tap logic: First tap activates the panel, second tap navigates to the link
            panel.addEventListener('click', (e) => {
                if (window.innerWidth <= 768) {
                    if (!panel.classList.contains('active')) {
                        e.preventDefault(); // Prevent navigation on the first tap
                        panels.forEach(p => p.classList.remove('active'));
                        panel.classList.add('active');

                        const bgImage = panel.getAttribute('data-bg');
                        if (accordionBg && bgImage) {
                            accordionBg.style.backgroundImage = `url('${bgImage}')`;
                        }
                    }
                    // If the panel is already active, the default behavior takes place and navigates to the page on the second tap
                }
            });
        });
    });
</script>