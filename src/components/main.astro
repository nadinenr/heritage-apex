---
/**
 * Component: Main / Hero Section
 * Description: Hero banner displaying the main brand identity, tagline, and background overlay.
 */
---

<section class="main-section" id="main">
    <!-- Hero Background Image -->
    <div class="main-image"></div>
    
    <!-- Dark Gradient Overlay -->
    <div class="main-overlay"></div>
    
    <!-- Hero Text Content -->
    <div class="main-content">
        <p class="main-label">ARCHITECTURE · INTERIORS</p>
        <h1 class="main-title">
            <span class="block">HERITAGE</span>
            <span class="block">APEX</span>
        </h1>
        <p class="main-subtitle">Where Experience Meets Creativity</p>
    </div>
</section>