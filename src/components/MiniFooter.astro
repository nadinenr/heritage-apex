
---
/**
 * Component: Mini Footer / Sub Footer
 * Description: Compact footer featuring contact action, social links, copyright, and policy links.
 */
---

<footer class="py-10 bg-white text-gray-900 border-t border-gray-200 mt-0">
    <div class="max-w-[1400px] w-full mx-auto px-6 md:px-12 flex flex-col gap-6">

        <!-- Main Footer Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-4 text-xs font-semibold tracking-wider">

            <!-- Left Column: Contact -->
            <div class="flex items-center justify-center md:justify-start">
                <a
                    href="mailto:info@heritageapex.net"
                    class="flex items-center gap-2 text-[13px] hover:text-[var(--accent-orange)] transition"
                >
                    <span>CONTACT OUR TEAM</span>
                    <span class="text-[var(--accent-orange)] text-base">↗</span>
                </a>
            </div>

            <!-- Center Column: Social Icons and Copyright -->
            <div class="flex flex-col items-center justify-center gap-2">

                <!-- Social Media Icons -->
                <div class="flex items-center justify-center gap-6">

                    <!-- LinkedIn -->
                    <a
                        href="https://linkedin.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                        class="text-gray-700 hover:text-[var(--accent-orange)] transition"
                    >
                        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                        </svg>
                    </a>

                    <!-- Instagram -->
                    <a
                        href="https://instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="text-gray-700 hover:text-[var(--accent-orange)] transition"
                    >
                        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                            <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.4 5.6 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.6 18.4 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
                        </svg>
                    </a>

                </div>

                <!-- Copyright -->
                <div class="text-center text-xs text-gray-400 font-light">
                    <p>&copy; 2026 HERITAGE APEX. All rights reserved.</p>
                </div>

            </div>

            <!-- Right Column: Legal Policies -->
            <div class="flex items-center justify-center md:justify-end gap-6">
                <a href="/privacy" class="hover:text-[var(--accent-orange)] transition">
                    PRIVACY POLICY
                </a>

                <a href="/terms" class="hover:text-[var(--accent-orange)] transition">
                    TERMS & CONDITIONS
                </a>
            </div>

        </div>
    </div>
</footer>

<!-- Professional Smart Mailto Redirect Script -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        const emailLinks = document.querySelectorAll('a[href^="mailto:"]');

        if (!isMobile) {
            emailLinks.forEach(link => {
                const email = link.getAttribute('href').replace('mailto:', '');

                link.setAttribute(
                    'href',
                    `https://mail.google.com/mail/?view=cm&fs=1&to=${email}`
                );

                link.setAttribute('target', '_blank');
                link.setAttribute('rel', 'noopener noreferrer');
            });
        }

    });
</script>
